# ===================================================
# CENTRAL DO ESCRIVÃO — POLÍCIA FEDERAL
# Configurações de Autenticação Discord OAuth2
# ===================================================

# Porta do servidor web
PORT=3000

# URL base da aplicação (ex: https://centralpf.duckdns.org ou http://localhost:3000)
BASE_URL=http://localhost:3000

# Chave secreta para assinatura segura dos cookies de sessão
SESSION_SECRET=central_escrivao_pf_segredo_super_seguro_2026

# Credenciais da Aplicação Discord (Discord Developer Portal -> Applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ID do Servidor Discord autorizado (Servidor da Polícia Federal RP)
DISCORD_GUILD_ID=

# ID do Cargo de "Escrivão" no servidor Discord
DISCORD_REQUIRED_ROLE_ID=

# Nome do cargo autorizado (padrão: Escrivão)
DISCORD_REQUIRED_ROLE_NAME=Escrivão

# Token do Bot Discord (Opcional: permite validar cargos diretamente pelo bot caso guilds.members.read não esteja habilitado)
DISCORD_BOT_TOKEN=
